#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/* 
 * 42-key Shared Keymap
 * Indices:
 * 0-11: Top Row
 * 12-23: Middle Row
 * 24-35: Bottom Row
 * 36-41: Thumb Keys
 */

#define LEFT_SIDE_KEYS 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38
#define RIGHT_SIDE_KEYS 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41

/ {
    /* Custom transform to map 42-key logical layout to Totem's 38-key physical matrix */
    totem_42_transform: totem_42_transform {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
                RC(3,1) RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(3,1)
                RC(3,1) RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(3,1)
                RC(3,0) RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(3,9)
                                RC(3,2) RC(3,3) RC(3,4)    RC(3,5) RC(3,6) RC(3,7)
        >;
    };

    behaviors {
        gresc: grave_escape {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;
            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <RIGHT_SIDE_KEYS>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <LEFT_SIDE_KEYS>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
&none          &kp Q          &kp W          &kp E          &kp R          &kp T          &kp Y          &kp U          &kp I          &kp O          &kp P          &none
&none          &hml LCTRL A   &hml LEFT_ALT S &hml LGUI D   &hml LSHFT F   &kp G          &kp H          &hmr RSHIFT J  &hmr RGUI K    &hmr RALT L    &hmr RCTRL SEMI &none
&kp GRAVE      &kp Z          &kp X          &kp C          &kp V          &kp B          &kp N          &kp M          &kp COMMA      &kp DOT        &kp SLASH      &kp BSLH
                                             &gresc         &lt 2 TAB      &kp SPACE      &kp RET        &lt 1 APOS     &kp BSPC
            >;
        };

        shift_layer {
            display-name = "SHFT";
            bindings = <
&trans         &kp EXCL       &kp AT         &kp HASH       &kp DLLR       &kp PRCNT      &kp CARET      &kp AMPS       &kp STAR       &kp LPAR       &kp RPAR       &trans
&trans         &kp N1         &kp N2         &kp N3         &kp N4         &kp N5         &kp N6         &kp N7         &kp N8         &kp N9         &kp N0         &trans
&trans         &kp F1         &kp F2         &kp F3         &kp F4         &kp F5         &kp F6         &kp F7         &kp F8         &kp F9         &kp F10        &trans
                                             &kp TILDE      &kp MINUS      &kp EQUAL      &kp F11        &trans         &kp F12
            >;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
&trans         &trans         &kp C_MUTE     &kp C_VOL_DN   &kp C_VOL_UP   &trans         &trans         &kp HOME       &trans         &kp END        &trans         &trans
&trans         &kp F13        &kp C_PREV     &kp C_PLAY_PAUSE &kp C_NEXT   &trans         &trans         &kp LEFT       &kp DOWN       &kp UP         &kp RIGHT      &trans
&trans         &kp F23        &kp F24        &kp F14        &kp F15        &trans         &trans         &kp PG_UP      &trans         &kp PG_DN      &trans         &trans
                                             &bt BT_PRV     &trans         &bt BT_NXT     &trans         &trans         &kp DEL
            >;
        };

        adj_layer {
            display-name = "ADJ";
            bindings = <
&trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans
&trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans
&trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans
                                             &trans         &trans         &trans         &trans         &trans         &trans
            >;
        };
    };
};
