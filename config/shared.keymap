#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/pointing.h>

/* 
 * 42-key Unified Logical Keymap (Active 36-key core for Totem and Toucan)
 *
 * === LAYER 0: QWERTY BASE LAYER ===
 *        [ LEFT HAND ]                                          [ RIGHT HAND ]
 * Top:    [ Q ]  [ W ]  [ E ]  [ R ]  [ T ]               [ Y ]  [ U ]  [ I ]  [ O ]  [ P ]
 * Home:   [ A ]  [ S ]  [ D ]  [ F ]  [ G ]               [ H ]  [ J ]  [ K ]  [ L ]  [ ' ]
 *         (Ctrl) (Alt)  (Gui)                                           (Gui)  (Alt)  (Ctrl)
 * Bottom: [ Z ]  [ X ]  [ C ]  [ V ]  [ B ]               [ N ]  [ M ]  [ , ]  [ . ]  [ / ]
 *                                                                       (;)    (:)    (?)
 *           Left Thumbs                                             Right Thumbs
 *    [ ESC / UTIL ]  [ STICKY SHIFT ]  [ BACKSPACE ]         [ ENTER ]  [ SPACE ]  [ TAB / UTIL ]
 *       (Hold L2)       (&sk LSHFT)     (Hold repeat)                     (Tap)       (Hold L3)
 *
 * === LAYER 1: COLEMAK-DH BASE LAYER ===
 *        [ LEFT HAND ]                                          [ RIGHT HAND ]
 * Top:    [ Q ]  [ W ]  [ F ]  [ P ]  [ B ]               [ J ]  [ L ]  [ U ]  [ Y ]  [ ' ]
 * Home:   [ A ]  [ R ]  [ S ]  [ T ]  [ G ]               [ M ]  [ N ]  [ E ]  [ I ]  [ O ]
 *         (Ctrl) (Alt)  (Gui)                                           (Gui)  (Alt)  (Ctrl)
 * Bottom: [ Z ]  [ X ]  [ C ]  [ D ]  [ V ]               [ K ]  [ H ]  [ , ]  [ . ]  [ / ]
 *                                                                       (;)    (:)    (?)
 *
 * === SHARED UTILITY LAYERS (Hold Left Esc -> L2, Hold Right Tab -> L3) ===
 *        [ LEFT HAND: NAV & MEDIA ]                             [ RIGHT HAND: CLASSIC NUMPAD ]
 * Top:    [ MUTE ] [VOL_DN] [VOL_UP] [ PREV ] [ NEXT ]        [ F11// ] [ 7/F7 ] [ 8/F8 ] [ 9/F9 ] [  *  ]
 * Home:   [ LEFT ] [ DOWN ] [  UP  ] [RIGHT ] [PLAY/PAUSE]    [ 0/F10 ] [ 4/F4 ] [ 5/F5 ] [ 6/F6 ] [  -  ]
 * Bottom: [ HOME ] [PG_DN ] [PG_UP ] [ END  ] [ DEL  ]        [ F12/= ] [ 1/F1 ] [ 2/F2 ] [ 3/F3 ] [  +  ]
 * Thumbs:                                                     [   .   ] [   0  ]
 *
 * === SYSTEM LAYER 4 (Hold BOTH Left Esc and Right Tab) ===
 * Top:    [BT_SEL 0] [BT_SEL 1] [BT_SEL 2] [BT_SEL 3] [BT_CLR]
 * Home:                        [QWERTY]                                [COL-DH]
 * Bottom: [RESET   ] [BOOTLOAD] [        ] [ F23    ] [ F24   ]  ...                       [RESET]
 *
 * Matrix Indices:
 * 0-11:  Top Row    (0 and 11 unused / &none)
 * 12-23: Middle Row (12 and 23 unused / &none)
 * 24-35: Bottom Row (24 and 35 unused / &none)
 * 36-41: Thumb Keys
 */

#define LEFT_SIDE_KEYS  1 2 3 4 5 13 14 15 16 17 25 26 27 28 29 36 37 38
#define RIGHT_SIDE_KEYS 6 7 8 9 10 18 19 20 21 22 30 31 32 33 34 39 40 41

/ {
    behaviors {
        gresc: grave_escape {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;
            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        /* Home Row Mods - Tap-Preferred with Prior Idle & Bilateral Isolation */
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <210>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <RIGHT_SIDE_KEYS>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <210>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <LEFT_SIDE_KEYS>;
            hold-trigger-on-release;
        };

        /* Smart Punctuation: Comma shifts to Semicolon */
        comma_morph: comma_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* Smart Punctuation: Period shifts to Colon */
        dot_morph: dot_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp COLON>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* Parentheses morph to Angle Brackets on Shift (Urob style) */
        lpar_lt: lpar_lt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LPAR>, <&kp LT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rpar_gt: rpar_gt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RPAR>, <&kp GT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* Numpad numbers morph to F-keys on Shift */
        num_f1: num_f1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N1>, <&kp F1>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        num_f2: num_f2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp F2>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        num_f3: num_f3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N3>, <&kp F3>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        num_f4: num_f4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N4>, <&kp F4>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        num_f5: num_f5 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N5>, <&kp F5>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        num_f6: num_f6 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N6>, <&kp F6>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        num_f7: num_f7 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N7>, <&kp F7>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        num_f8: num_f8 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N8>, <&kp F8>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        num_f9: num_f9 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&kp F9>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        num_f0: num_f0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N0>, <&kp F10>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        num_f11: num_f11 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp F11>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        num_f12: num_f12 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp F12>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* Quick Utility Combos */
        combo_caps_word {
            timeout-ms = <40>;
            key-positions = <15 20>;
            bindings = <&caps_word>;
            require-prior-idle-ms = <150>;
        };

        /* Horizontal Brackets & Delimiters */
        combo_lpar {
            timeout-ms = <35>;
            key-positions = <19 20>;
            bindings = <&lpar_lt>;
            require-prior-idle-ms = <150>;
        };

        combo_rpar {
            timeout-ms = <35>;
            key-positions = <20 21>;
            bindings = <&rpar_gt>;
            require-prior-idle-ms = <150>;
        };

        /* Direct Bottom-Row Angle Brackets: < [ ] > */
        combo_lt {
            timeout-ms = <35>;
            key-positions = <30 31>;
            bindings = <&kp LT>;
            require-prior-idle-ms = <150>;
        };

        combo_lbkt {
            timeout-ms = <35>;
            key-positions = <31 32>;
            bindings = <&kp LBKT>;
            require-prior-idle-ms = <150>;
        };

        combo_rbkt {
            timeout-ms = <35>;
            key-positions = <32 33>;
            bindings = <&kp RBKT>;
            require-prior-idle-ms = <150>;
        };

        combo_gt {
            timeout-ms = <35>;
            key-positions = <33 34>;
            bindings = <&kp GT>;
            require-prior-idle-ms = <150>;
        };

        /* Vertical Combos - Left Hand (Top + Home: Number Row Symbols) */
        combo_excl {
            timeout-ms = <40>;
            key-positions = <1 13>;
            bindings = <&kp EXCL>;
            require-prior-idle-ms = <150>;
        };

        combo_at {
            timeout-ms = <40>;
            key-positions = <2 14>;
            bindings = <&kp AT>;
            require-prior-idle-ms = <150>;
        };

        combo_hash {
            timeout-ms = <40>;
            key-positions = <3 15>;
            bindings = <&kp HASH>;
            require-prior-idle-ms = <150>;
        };

        combo_dollar {
            timeout-ms = <40>;
            key-positions = <4 16>;
            bindings = <&kp DLLR>;
            require-prior-idle-ms = <150>;
        };

        combo_percent {
            timeout-ms = <40>;
            key-positions = <5 17>;
            bindings = <&kp PRCNT>;
            require-prior-idle-ms = <150>;
        };

        /* Vertical Combos - Right Hand (Top + Home: Math & Symbols) */
        combo_caret {
            timeout-ms = <40>;
            key-positions = <6 18>;
            bindings = <&kp CARET>;
            require-prior-idle-ms = <150>;
        };

        combo_plus {
            timeout-ms = <40>;
            key-positions = <7 19>;
            bindings = <&kp PLUS>;
            require-prior-idle-ms = <150>;
        };

        combo_star {
            timeout-ms = <40>;
            key-positions = <8 20>;
            bindings = <&kp ASTRK>;
            require-prior-idle-ms = <150>;
        };

        combo_amps {
            timeout-ms = <40>;
            key-positions = <9 21>;
            bindings = <&kp AMPS>;
            require-prior-idle-ms = <150>;
        };

        /* Vertical Combos - Left Hand (Home + Bottom: Punctuation & Math) */
        combo_grave {
            timeout-ms = <40>;
            key-positions = <14 26>;
            bindings = <&kp GRAVE>;
            require-prior-idle-ms = <150>;
        };

        combo_bslh {
            timeout-ms = <40>;
            key-positions = <15 27>;
            bindings = <&kp BSLH>;
            require-prior-idle-ms = <150>;
        };

        combo_equal {
            timeout-ms = <40>;
            key-positions = <16 28>;
            bindings = <&kp EQUAL>;
            require-prior-idle-ms = <150>;
        };

        combo_tilde {
            timeout-ms = <40>;
            key-positions = <17 29>;
            bindings = <&kp TILDE>;
            require-prior-idle-ms = <150>;
        };

        /* Vertical Combos - Right Hand (Home + Bottom: Operators) */
        combo_under {
            timeout-ms = <40>;
            key-positions = <18 30>;
            bindings = <&kp UNDER>;
            require-prior-idle-ms = <150>;
        };

        combo_minus {
            timeout-ms = <40>;
            key-positions = <19 31>;
            bindings = <&kp MINUS>;
            require-prior-idle-ms = <150>;
        };

        combo_slash {
            timeout-ms = <40>;
            key-positions = <20 32>;
            bindings = <&kp FSLH>;
            require-prior-idle-ms = <150>;
        };

        combo_pipe {
            timeout-ms = <40>;
            key-positions = <21 33>;
            bindings = <&kp PIPE>;
            require-prior-idle-ms = <150>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: Unified 36-key QWERTY Base */
        base_layer {
            display-name = "QWERT";
            bindings = <
&none  &kp Q         &kp W          &kp E         &kp R         &kp T            &kp Y       &kp U         &kp I         &kp O         &kp P          &none
&none  &hml LCTRL A  &hml LEFT_ALT S &hml LGUI D  &kp F         &kp G            &kp H       &kp J         &hmr RGUI K   &hmr RALT L   &hmr RCTRL SQT &none
&none  &kp Z         &kp X          &kp C         &kp V         &kp B            &kp N       &kp M         &comma_morph  &dot_morph    &kp SLASH      &none
                                    &lt 2 ESC     &kp BSPC      &sk LSHFT        &kp RET     &kp SPACE     &lt 3 TAB
            >;
        };

        /* Layer 1: Unified 36-key Colemak-DH Base */
        colemak_layer {
            display-name = "COLE";
            bindings = <
&none  &kp Q         &kp W          &kp F         &kp P         &kp B            &kp J       &kp L         &kp U         &kp Y         &kp SQT        &none
&none  &hml LCTRL A  &hml LEFT_ALT R &hml LGUI S  &kp T         &kp G            &kp M       &kp N         &hmr RGUI E   &hmr RALT I   &hmr RCTRL O   &none
&none  &kp Z         &kp X          &kp C         &kp D         &kp V            &kp K       &kp H         &comma_morph  &dot_morph    &kp SLASH      &none
                                    &lt 2 ESC     &kp BSPC      &sk LSHFT        &kp RET     &kp SPACE     &lt 3 TAB
            >;
        };

        /* Layer 2: Left Utility (Active when Left Outer Thumb is held) */
        util_left_layer {
            display-name = "UTIL";
            bindings = <
&none  &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_PREV   &kp C_NEXT       &num_f11   &num_f7   &num_f8   &num_f9   &kp ASTRK  &none
&none  &kp LEFT   &kp DOWN     &kp UP       &kp RIGHT    &kp C_PLAY_PAUSE &num_f0    &num_f4   &num_f5   &num_f6   &kp MINUS  &none
&none  &kp HOME   &kp PG_DN    &kp PG_UP    &kp END      &kp DEL          &num_f12   &num_f1   &num_f2   &num_f3   &kp PLUS   &none
                               &trans       &trans       &trans           &kp DOT    &kp N0    &trans
            >;
        };

        /* Layer 3: Right Utility (Identical mapping, active when Right Outer Thumb is held) */
        util_right_layer {
            display-name = "UTIL";
            bindings = <
&none  &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_PREV   &kp C_NEXT       &num_f11   &num_f7   &num_f8   &num_f9   &kp ASTRK  &none
&none  &kp LEFT   &kp DOWN     &kp UP       &kp RIGHT    &kp C_PLAY_PAUSE &num_f0    &num_f4   &num_f5   &num_f6   &kp MINUS  &none
&none  &kp HOME   &kp PG_DN    &kp PG_UP    &kp END      &kp DEL          &num_f12   &num_f1   &num_f2   &num_f3   &kp PLUS   &none
                               &trans       &trans       &trans           &kp DOT    &kp N0    &trans
            >;
        };

        /* Layer 4: System & Hardware Controls (Active when BOTH outer thumbs are held) */
        sys_layer {
            display-name = "SYS";
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR       &none       &none     &none     &none     &none      &none
&none  &none         &none         &none         &to 0         &none            &none       &to 1     &none     &none     &none      &none
&none  &sys_reset    &bootloader   &none         &kp F23       &kp F24          &none       &none     &none     &none     &sys_reset &none
                                   &trans        &trans        &trans           &trans      &trans    &trans
            >;
        };

        /* Layer 5: Mouse Controls (Activated automatically while touching trackpad) */
        mouse_layer {
            display-name = "MOU";
            bindings = <
&trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
              &mkp MCLK &mkp LCLK &mkp RCLK         &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };
    };
};
